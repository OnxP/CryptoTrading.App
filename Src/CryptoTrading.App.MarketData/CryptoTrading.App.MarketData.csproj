<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="System.Net.Security" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Binance.csproj (bundled SDK) is still referenced because the public
      IMarketData / IMarketDataEvents / IMarketMonitor contracts surface
      bundled-SDK types (Candlestick, CandlestickInterval, CandlestickEventArgs)
      to 15+ algorithm / monitor consumers. The implementation classes have
      been rewired to IExchangeProvider (Binance.Net) in PR 5b — a follow-up
      PR migrates the interfaces themselves and drops the two bundled deps
      below along with Src/Samples.
    -->
    <ProjectReference Include="..\Binance\Binance.csproj" />
    <ProjectReference Include="..\CryptoTrading.App.Core\CryptoTrading.App.Core.csproj" />
    <ProjectReference Include="..\CryptoTrading.App.Exchange.BinanceNet\CryptoTrading.App.Exchange.BinanceNet.csproj" />
    <ProjectReference Include="..\Samples\Binance.Application\Binance.Application.csproj" />
  </ItemGroup>

</Project>
