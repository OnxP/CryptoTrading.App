// Render once, on the first bar. Labels/lines are time-anchored
// (xloc.bar_time) so they land at absolute UTC times regardless of
// the current chart's timeframe or scroll position.
if barstate.isfirst
    for i = 0 to array.size(entryTimes) - 1
        et     = array.get(entryTimes,  i)
        xt     = array.get(exitTimes,   i)
        ep     = array.get(entryPrices, i)
        xp     = array.get(exitPrices,  i)
        d      = array.get(dirs,        i)
        r      = array.get(reasons,     i)
        p      = array.get(pnls,        i)
        isLong = d == "Long"
        isWin  = p > 0

        // Respect display filters
        showIt = (isLong ? showLongs : showShorts) and
                 (isWin  ? showWins  : showLosers)

        if showIt
            entryColor = isLong ? color.new(color.lime, 0) : color.new(color.orange, 0)
            lineColor  = isWin  ? color.new(color.green, 30) : color.new(color.red, 30)

            // Entry arrow
            entryText = showPnl ? d + " " + str.tostring(p, "#") : d
            label.new(x=et, y=ep, xloc=xloc.bar_time,
                      text=entryText,
                      style=isLong ? label.style_label_up : label.style_label_down,
                      color=entryColor, textcolor=color.black,
                      size=size.tiny,
                      tooltip=d + " entry @ " + str.tostring(ep, "#.##") +
                              "\nExit: " + r + " @ " + str.tostring(xp, "#.##") +
                              "\nP&L: " + str.tostring(p, "#.##"))

            // Exit marker
            exitColor = isWin ? color.new(color.green, 0) : color.new(color.red, 0)
            exitText = showExitReason ? r : ""
            label.new(x=xt, y=xp, xloc=xloc.bar_time,
                      text=exitText,
                      style=label.style_xcross,
                      color=exitColor, textcolor=color.white,
                      size=size.tiny)

            // Entry → exit line
            if showLines
                line.new(x1=et, y1=ep, x2=xt, y2=xp, xloc=xloc.bar_time,
                         color=lineColor, width=1,
                         style=line.style_solid)

// Summary in top-right — reads from the arrays so it reflects the
// current display filters implicitly via the label/line plotting.
var table summary = table.new(position.top_right, 2, 4,
                              bgcolor=color.new(color.black, 75),
                              border_width=1)
if barstate.islast
    table.cell(summary, 0, 0, "Source",   text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(summary, 1, 0, "trades_arm_F_bbguide.csv", text_color=color.white)
    table.cell(summary, 0, 1, "Trades",   text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(summary, 1, 1, "142 (45L/97S)", text_color=color.white)
    table.cell(summary, 0, 2, "Win rate", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(summary, 1, 2, "55.6% (79/142)",     text_color=color.white)
    table.cell(summary, 0, 3, "Net P&L",  text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(summary, 1, 3, "14,073,923", text_color=color.lime)
