// ============================================================================
// Auto-generated from trades_arm_F_bbguide.csv (142 filled trades)
// ============================================================================
// Paste into TradingView → Pine Editor → Save → Add to chart.
// Each trade renders as an entry arrow, an exit X, and a line joining
// them. Line colour = green (win) / red (loss). Exit symbol text =
// exit reason. Hover a label for full details.
// ============================================================================

//@version=5
indicator("Backtest trades — trades_arm_F_bbguide.csv", overlay=true, max_labels_count=500, max_lines_count=500)

// Display controls
showLongs      = input.bool(true,  "Show longs",            group="Display")
showShorts     = input.bool(true,  "Show shorts",           group="Display")
showWins       = input.bool(true,  "Show winners",          group="Display")
showLosers     = input.bool(true,  "Show losers",           group="Display")
showLines      = input.bool(true,  "Draw entry→exit lines", group="Display")
showExitReason = input.bool(true,  "Label exit reasons",    group="Display")
showPnl        = input.bool(false, "Label entry P&L",       group="Display")

// Trade arrays — index-aligned. Built once on the very first bar the
// indicator runs on; then painted via time-anchored labels/lines so
// they sit at the correct historical timestamps on any timeframe.
var entryTimes  = array.new_int(0)
var exitTimes   = array.new_int(0)
var entryPrices = array.new_float(0)
var exitPrices  = array.new_float(0)
var dirs        = array.new_string(0)
var reasons     = array.new_string(0)
var pnls        = array.new_float(0)

